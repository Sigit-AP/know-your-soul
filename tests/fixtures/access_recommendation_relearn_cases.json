  "relearn_cases": [
    {
      "id": "rl-001-relearn-offer",
      "case_type": "relearn_offer",
      "description": "A SOUL.md or corpus change emits a deterministic RelearnOffer and sets RELEARN_PENDING; no mode is chosen automatically.",
      "given": {
        "source_change": "soul_md sha256 changed"
      },
      "expected": {
        "emits": "RelearnOffer",
        "status": "RELEARN_PENDING",
        "automatic_mode_selection": false,
        "no_change_without_operator_decision": true
      }
    },
    {
      "id": "rl-002-reset",
      "case_type": "reset",
      "mode": "RESET",
      "description": "RESET starts with zero old evidence.",
      "expected": {
        "scores": {
          "p": "0.000000000000",
          "m": "0.000000000000",
          "e": "0.000000000000",
          "u": "1.000000000000",
          "professional_level": 1
        },
        "promotion_blocked": true,
        "old_evidence_carried": 0
      }
    },
    {
      "id": "rl-003-accumulate-quarantine",
      "case_type": "accumulate",
      "mode": "ACCUMULATE",
      "description": "ACCUMULATE reuses only nodes whose anchors map deterministically; unmapped evidence is quarantined from scoring.",
      "expected": {
        "scored_evidence_ids": [
          "e0001",
          "e0002"
        ],
        "quarantined_evidence_ids": [
          "e0003",
          "e0004"
        ],
        "mapping_required": "approved deterministic anchor mapping"
      }
    },
    {
      "id": "rl-004-mixed-source-refusal",
      "case_type": "mixed_source",
      "description": "A default response spanning incompatible source versions fails.",
      "expected": {
        "default_mixed_response": true,
        "outcome": "error",
        "error_code": "MIXED_SOURCE_VERSIONS"
      }
    },
    {
      "id": "rl-005-mixed-source-approved",
      "case_type": "mixed_source",
      "description": "A mixed response is allowed only with explicit operator approval and mixed_source_versions=true.",
      "expected": {
        "mixed_source_versions": true,
        "operator_approval": true,
        "outcome": "ok"
      }
    },
    {
      "id": "rl-006-zero-evidence-weight",
      "case_type": "zero_evidence_weight",
      "description": "Relearn, source-version, backup, and rollback events carry zero evidence weight; only log_event, record_outcome, and evaluate can move P/M/E; relearn never triggers promotion.",
      "zero_weight_event_kinds": [
        "relearn",
        "source_version",
        "backup",
        "rollback"
      ],
      "score_moving_tools": [
        "log_event",
        "record_outcome",
        "evaluate"
      ],
      "expected": {
        "relearn_never_triggers_promotion": true
      }
    },
    {
      "id": "rl-007-rollback",
      "case_type": "rollback",
      "description": "Rollback restores exact pre-relearn hashes, graph bytes, and P/M/E values with exactly one linked audit event.",
      "expected": {
        "restores_pre_relearn_hashes": true,
        "restores_pre_relearn_scores": true,
        "restores_graph_bytes": true,
        "linked_audit_events": 1
      }
    },
    {
      "id": "rl-008-supersession",
      "case_type": "supersession",
      "description": "Supersession uses valid-from/valid-to relation fields with audit retention, never deletion; ties stay needs_improvement.",
      "expected": {
        "uses_valid_from_valid_to": true,
        "deletion": false,
        "contradictions_retained_both_directions": true,
        "tie_resolution": "needs_improvement"
      }
    },
    {
      "id": "rl-009-source-version-registry",
      "case_type": "source_version_registry",
      "description": "The registry stores hashes and tool versions; mtime is never a correctness gate.",
      "expected": {
        "fields": [
          "sha256",
          "byte_count",
          "char_count",
          "line_count",
          "manifest_hash",
          "parser_version",
          "normalization_version",
          "engine_version",
          "scoring_version",
          "superseded_by",
          "deletion_state"
        ],
        "version_identity": "sha256",
        "mtime_is_correctness_gate": false
      }
    }
  ]
